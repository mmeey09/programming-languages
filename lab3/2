class Product:
    def __init__(self, name, price, quantity):
        self.name = name
        self.price = price
        self.quantity = quantity

    def show_info(self):
        print("Название:", self.name)
        print("Цена:", self.price)
        print("Количество:", self.quantity)

    def change_price(self, new_price):
        self.price = new_price

    def add_product(self, amount):
        self.quantity = self.quantity + amount

    def stock_cost(self):
        return self.price * self.quantity


product = Product("Ноутбук", 300000, 5)

print("Информация о товаре:")
product.show_info()

product.change_price(280000)
product.add_product(2)

print("\nПосле изменения:")
product.show_info()

print("Стоимость запасов:", product.stock_cost())

