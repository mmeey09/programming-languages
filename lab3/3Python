class Library:
    def __init__(self):
        self.books = []

    def add_book(self, book):
        self.books.append(book)

    def delete_book(self, book):
        if book in self.books:
            self.books.remove(book)
            print("Книга удалена")
        else:
            print("Книга не найдена")

    def find_book(self, name):
        for book in self.books:
            if book == name:
                print("Книга найдена:", book)
                return

        print("Книга не найдена")


library = Library()

library.add_book("Гарри Поттер")
library.add_book("Война и мир")
library.add_book("Маленький принц")

print("Поиск книги:")
library.find_book("Война и мир")

print("\nУдаление книги:")
library.delete_book("Гарри Поттер")

print("\nПоиск удалённой книги:")
library.find_book("Гарри Поттер")


